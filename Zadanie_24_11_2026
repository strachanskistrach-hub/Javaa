import java.util.Random;
import java.util.Scanner;
public class Main {
    static void wypelnijTablice(int[] tablica) {
        Random rand = new Random();

        for(int i = 0; i < tablica.length; i++){
            tablica[i] = rand.nextInt(100) + 1;
        }
    }
    static int wyszukaj(int[] tablica, int szukana){
        int n = tablica.length;
        int[] pomoc = new int[n + 1];

        for(int i = 0; i < n; i++){
            pomoc[n] = tablica[i];
        }

        pomoc[n] = szukana;
        int i =0;

        while (pomoc[i] != szukana) {
            i++;
        }
        if(i==n){
            return -1;
        }
        return i;
    }

    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);

        int[] tablica = new int[50];
        wypelnijTablice(tablica);

        System.out.print("Podaj liczbe do wyszukania: ");
        int szukana = scanner.nextInt();

        System.out.print("\nZawartosc tabliczy: ");

        for(int i = 0; i < tablica.length ; i++){
            System.out.print(tablica[i]);

            if(i < tablica.length - 1){
                System.out.print(", ");
            }
        }

        int wynik = wyszukaj(tablica,szukana);
        if(wynik == -1){
            System.out.print("\n\nNie znaleziono liczby " + szukana + " w tablicy");
        }else {
            System.out.print("\n\nLiczba " + szukana + " została znaleziona pod indeksem: " + wynik);
        }

        scanner.close();
    }
}
